{
  "name": "atomic-launcher",
  "productName": "Atomic",
  "version": "1.0.0",
  "description": "Atomic - launcher Minecraft z kosmetykami",
  "main": "main.js",
  "author": "Atomic",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "eu.westmc.atomic",
    "productName": "Atomic",
    "artifactName": "Atomic-Setup.${ext}",
    "directories": { "buildResources": "assets", "output": "dist" },
    "files": ["main.js", "preload.js", "config.json", "src/**", "renderer/**"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atomic",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
